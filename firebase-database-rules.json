{
  "rules": {
    "allowedEmails": {
      ".read": true,
      ".write": "auth != null && root.child('adminEmails').child(auth.token.email).exists()"
    },
    "adminEmails": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('adminEmails').child(auth.token.email).exists()"
    },
    "agents": {
      ".read": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()",
      ".write": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()"
    },
    "commissions": {
      ".read": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()",
      ".write": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()"
    },
    "analystExpenses": {
      ".read": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()",
      ".write": "auth != null && root.child('allowedEmails').child(auth.token.email).exists()"
    }
  }
}
