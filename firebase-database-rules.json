{
  "rules": {
    "admins": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "allowedUsers": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "agents": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).exists()"
    },
    "commissions": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).exists()"
    },
    "analystExpenses": {
      ".read": "auth != null && root.child('allowedUsers').child(auth.uid).exists()",
      ".write": "auth != null && root.child('allowedUsers').child(auth.uid).exists()"
    }
  }
}
