APP_ENV=production
APP_URL=https://admin.lusciana.fr
# Origines autorisees (CORS), sans chemin /pages. Plusieurs URLs separees par des virgules si besoin (www, preprod, GitHub Pages, etc.)
FRONTEND_URL=https://admin.lusciana.fr

MONGODB_URI=mongodb://luna:CHANGE_ME@mongodb:27017/lusciana?authSource=admin
MONGODB_DATABASE=lusciana

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM_REFRESH_SECRET
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=28800

SUPERADMIN_EMAIL=admin@lusciana.fr
SUPERADMIN_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD
SUPERADMIN_NAME="Lusciana Owner"

# Discord tickets — branchement avec TON bot existant (recommande)
# Secret partage : ton bot l envoie dans le header X-Lusciana-Tickets-Key
DISCORD_TICKETS_INGEST_SECRET=
DISCORD_GUILD_ID=

# Secours optionnel : import direct des salons via API Discord (meme token bot)
DISCORD_BOT_TOKEN=
DISCORD_TICKET_NAME_PREFIX=ticket-
DISCORD_TICKET_CATEGORY_ID=
